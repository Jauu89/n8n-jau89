    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json);\nconst alerts = rows.filter(r => parseFloat(r.Stock_Actual || 0) <= parseFloat(r.Stock_Minimo || 0));\n\nconst tableRows = alerts.map(row => `\n  <tr>\n    <td>${row.ID}</td>\n    <td><strong>${row.Nombre}</strong></td>\n    <td style=\"text-align:center;color:#dc2626;font-weight:600\">${row.Stock_Actual} ${row.Unidad || ''}</td>\n    <td style=\"text-align:center\">${row.Stock_Minimo}</td>\n    <td>${row.Categoria || ''}</td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Alertas de Stock</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{font-family:system-ui,Arial,sans-serif;background:#fff7f7;padding:24px}\n  h1{color:#dc2626;font-size:22px;margin-bottom:4px}\n  .meta{color:#64748b;font-size:13px;margin-bottom:20px}\n  .card{background:white;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.1);overflow:hidden}\n  table{width:100%;border-collapse:collapse}\n  th{background:#dc2626;color:white;padding:10px 14px;text-align:left;font-size:13px;font-weight:600}\n  td{padding:10px 14px;border-bottom:1px solid #fef2f2;font-size:13px;vertical-align:middle}\n  tr:last-child td{border-bottom:none}\n  .ok{color:#16a34a;font-size:18px;text-align:center;padding:40px}\n  .btn{position:fixed;top:16px;right:16px;background:#dc2626;color:white;border:none;padding:9px 18px;border-radius:8px;cursor:pointer;font-size:14px;font-family:inherit}\n  @media print{.btn{display:none}body{background:white}}\n</style></head><body>\n<button class=\"btn\" onclick=\"window.print()\">🖨️ Imprimir</button>\n<h1>⚠️ Alertas de Stock Bajo</h1>\n<p class=\"meta\">${alerts.length} producto(s) por debajo del mínimo · ${new Date().toLocaleString('es-ES')}</p>\n${alerts.length === 0\n  ? '<div class=\"card\"><p class=\"ok\">✅ ¡Todo el stock está en niveles correctos!</p></div>'\n  : `<div class=\"card\"><table><thead><tr>\n      <th>ID</th><th>Producto</th><th>Stock Actual</th><th>Mínimo</th><th>Categoría</th>\n    </tr></thead><tbody>${tableRows}</tbody></table></div>`}\n</body></html>`;\n\nreturn [{json: {html}}];"
      },
