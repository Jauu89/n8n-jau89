    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json);\n\nfunction badge(row) {\n  return parseFloat(row.Stock_Actual || 0) <= parseFloat(row.Stock_Minimo || 0)\n    ? '<span style=\"background:#fee2e2;color:#dc2626;padding:2px 8px;border-radius:9999px;font-size:11px\">⚠ Bajo</span>'\n    : '<span style=\"background:#dcfce7;color:#16a34a;padding:2px 8px;border-radius:9999px;font-size:11px\">✓ OK</span>';\n}\n\nconst tableRows = rows.map(row => `\n  <tr>\n    <td>${row.ID || ''}</td>\n    <td><strong>${row.Nombre || ''}</strong><br><small style=\"color:#6b7280\">${row.Descripcion || ''}</small></td>\n    <td>${row.Categoria || ''}</td>\n    <td style=\"text-align:right\">${parseFloat(row.Precio_Venta || 0).toFixed(2)} €</td>\n    <td style=\"text-align:center\">${row.Stock_Actual || 0} ${row.Unidad || ''}</td>\n    <td style=\"text-align:center\">${row.Stock_Minimo || 0}</td>\n    <td style=\"text-align:center\">${badge(row)}</td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Inventario de Stock</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{font-family:system-ui,Arial,sans-serif;background:#f1f5f9;padding:24px}\n  h1{color:#1e40af;font-size:22px;margin-bottom:4px}\n  .meta{color:#64748b;font-size:13px;margin-bottom:20px}\n  .card{background:white;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.1);overflow:hidden}\n  table{width:100%;border-collapse:collapse}\n  th{background:#1e40af;color:white;padding:10px 14px;text-align:left;font-size:13px;font-weight:600}\n  td{padding:10px 14px;border-bottom:1px solid #f1f5f9;font-size:13px;vertical-align:middle}\n  tr:last-child td{border-bottom:none}\n  tr:hover td{background:#f8fafc}\n  .btn{position:fixed;top:16px;right:16px;background:#1e40af;color:white;border:none;padding:9px 18px;border-radius:8px;cursor:pointer;font-size:14px;font-family:inherit}\n  @media print{.btn{display:none}body{background:white;padding:0}}\n</style></head><body>\n<button class=\"btn\" onclick=\"window.print()\">🖨️ Imprimir</button>\n<h1>📦 Inventario de Stock</h1>\n<p class=\"meta\">Total: ${rows.length} productos · Actualizado: ${new Date().toLocaleString('es-ES')}</p>\n<div class=\"card\">\n<table><thead><tr>\n  <th>ID</th><th>Producto</th><th>Categoría</th><th>Precio Venta</th><th>Stock Actual</th><th>Mínimo</th><th>Estado</th>\n</tr></thead><tbody>${tableRows}</tbody></table>\n</div></body></html>`;\n\nreturn [{json: {html}}];"
      },
